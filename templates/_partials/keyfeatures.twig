{# templates/_partials/keyfeatures.twig #}
<section
  id="features"
  class="lp-features container"
  aria-labelledby="features-heading"
>
  <h2 id="features-heading" class="heading">Key features</h2>
  <p class="desc">
    DeeTickets streamlines your ticket management with intuitive features designed for efficiency and clarity.
  </p>

  <div class="features-grid">
    <article class="feature-card card" role="region" aria-labelledby="f1">
      <h3 id="f1" class="feature-title">Create & Track Tickets Seamlessly</h3>
      <p class="feature-desc">
        Open tickets quickly, assign owners, set priorities, and follow the lifecycle with clear timelines and status tags.
      </p>
    </article>

    <article class="feature-card card" role="region" aria-labelledby="f2">
      <h3 id="f2" class="feature-title">Stay Organized with Real-Time Updates</h3>
      <p class="feature-desc">
        Receive instant updates and notifications so everyone stays in sync, no more guesswork or out-of-date dashboards.
      </p>
    </article>

    <article class="feature-card card" role="region" aria-labelledby="f3">
      <h3 id="f3" class="feature-title">User-Friendly Interface</h3>
      <p class="feature-desc">
        Navigate an intuitive dashboard designed for quick access to your tickets, filters, and reports.
      </p>
    </article>

    <article class="feature-card card" role="region" aria-labelledby="f4">
      <h3 id="f4" class="feature-title">Level Up Management with Collaboration Tools</h3>
      <p class="feature-desc">
        Collaborate effortlessly with team comments, file attachments, and shared ticket views.
      </p>
    </article>
  </div>
</section>
